# Copy this file to backend/.env before running locally.
# Every key below is read by app/config/settings.py.
# Passwords in this file are EXAMPLES ONLY — change them in real deployments.

ENVIRONMENT=development          # development | testing | production
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database — adjust user/password/host to match your MySQL setup
DATABASE_URL=mysql+pymysql://hp_user:YOUR_DB_PASSWORD@localhost:3306/healthpredict
DB_ECHO=false

# Secret key for JWT signing.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production, ALWAYS set a strong random key. The app refuses to start without one.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

# Frontend application URL (used in email links for reset password and email verification)
APP_URL=http://localhost:5173

# Comma-separated list of allowed web/mobile origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8081

# Cookie security (set to true in production with HTTPS)
COOKIE_SECURE=false

# Dedicated test database (default port 3306)
TEST_DATABASE_URL=mysql+pymysql://hp_user:hp_password_123@localhost:3306/healthpredict_test

# Email (SMTP) — use MailHog for local development (started by docker-compose)
# MailHog web UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_SSL=false
SMTP_FROM=noreply@healthpredict.local

# Optional Cloud Email APIs (alternatives to SMTP)
RESEND_API_KEY=
SENDGRID_API_KEY=

# Rate limiting for auth endpoints (per client IP)
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REDIS_URL=

# Demo accounts created by seed_data.py (development only).
# Passwords MUST satisfy: 8+ chars, upper, lower, digit, special character.
# CHANGE THESE — the values below are examples only, not defaults.
ADMIN_EMAIL=admin@healthpredict.local
ADMIN_PASSWORD=
DEMO_EMAIL=demo@healthpredict.local
DEMO_PASSWORD=

ML_MODEL_PATH=../ml/saved_models

