# Each part of the project reads its own env file; copy the matching example:
#   backend/.env.example  ->  backend/.env        (database, secrets, CORS, seed passwords)
#   web/.env.example      ->  web/.env.local      (VITE_API_BASE_URL)
#   mobile/.env.example   ->  mobile/.env         (EXPO_PUBLIC_API_BASE_URL)
# Never commit the copied files (they are in .gitignore).

# ── Docker Compose ───────────────────────────────────────────────────────────
# docker-compose.yml reads these variables via ${VAR} substitution.
# Copy this file to .env and fill in real values before running docker-compose up.

MYSQL_ROOT_PASSWORD=          # Strong root password for MySQL container
MYSQL_USER=hp_user            # Application database user
MYSQL_PASSWORD=               # Application database password
SECRET_KEY=                   # Minimum 32-char random string (e.g. openssl rand -base64 48)
ADMIN_PASSWORD=               # Admin account password (min 8 chars, 1 upper, 1 digit, 1 special)
DEMO_PASSWORD=                # Demo account password (same requirements)

# Reminder scheduler (runs inside the API process)
# Keep ONE API worker, or set this to false on all but one worker to avoid duplicate reminders.
ENABLE_BACKGROUND_SCHEDULER=true
REMINDER_INTERVAL_SECONDS=60
