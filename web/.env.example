# Copy this file to web/.env.local before running locally.
# Using /api (relative) means the Vite dev proxy handles it, and the app
# also works from a phone on the same Wi-Fi when accessed by IP.
VITE_API_BASE_URL=/api

# Set to true to display the Ingestion Simulator (Demo) tab on the Track page for developer payload testing.
VITE_ENABLE_DEMO=false
