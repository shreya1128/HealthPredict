# HealthPredict mobile - copy to `.env` (git-ignored) and edit. Restart `npx expo start` after changing it.
# Only EXPO_PUBLIC_* variables are readable by the app, and they are baked into the JS bundle:
# never put secrets here.

# ---------------------------------------------------------------------------------------------
# BACKEND ADDRESS  <-- THIS IS THE LINE YOU EDIT FOR A PHYSICAL PHONE
# ---------------------------------------------------------------------------------------------
# Full URL of the FastAPI backend, including the /api prefix:
#   Physical phone (same Wi-Fi as your computer): http://<your-computer-LAN-IP>:8000/api
#   Android emulator:                             http://10.0.2.2:8000/api
#   iOS simulator:                                http://localhost:8000/api
# If you leave this empty, the app tries to work it out automatically in development
# (see mobile/README.md, "How the API URL is chosen").
EXPO_PUBLIC_API_BASE_URL=

# Backend port used by the automatic fallback only (ignored when EXPO_PUBLIC_API_BASE_URL is set).
EXPO_PUBLIC_API_PORT=8000

# Request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT=30000
